# ─── HackerAI Offline — Variáveis de Ambiente ─────────────────────────────
# Copie para .env e ajuste conforme seu setup
# cp .env.example .env

# ─── LLM Backend ──────────────────────────────────────────────────────────
# "ollama" = usa Qwen no Docker (recomendado para início)
# "lm_studio" = usa LM Studio rodando no host
LLM_BACKEND=ollama

# LM Studio (se LLM_BACKEND=lm_studio)
LM_STUDIO_URL=http://host.docker.internal:1234
LM_STUDIO_MODEL=local-model

# Ollama / Qwen (se LLM_BACKEND=ollama)
OLLAMA_MODEL=qwen2.5-coder:7b
# Alternativas: qwen2.5:7b | qwen2.5-coder:14b | qwen2.5:14b

# ─── Segurança ────────────────────────────────────────────────────────────
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-char-string

# ─── Sandbox ──────────────────────────────────────────────────────────────
MAX_CONCURRENT_SANDBOXES=4
SANDBOX_TIMEOUT_SECONDS=300

# ─── Docker ───────────────────────────────────────────────────────────────
# Linux: deixe como está
DOCKER_HOST=unix:///var/run/docker.sock
# macOS com Docker Desktop:
# DOCKER_HOST=unix:///var/run/docker.sock
